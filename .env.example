# BRAVE_SEARCH_API_KEY: used live by the Search Broker (src/tools/searchBroker.ts) for
# Company Research. Leave empty to fall back to the deterministic stub (used by tests).
BRAVE_SEARCH_API_KEY=

# Which LLM provider to use: "openrouter" or "azure". Leave unset to auto-detect (OpenRouter
# wins if OPENROUTER_API_KEY is set, else Azure if AZURE_OPENAI_API_KEY is set, else full
# stub mode — no regression for an existing Azure setup just because this var is unset). If
# set explicitly, that provider must be fully configured below or startup throws.
LLM_PROVIDER=

# OpenRouter connection (https://openrouter.ai/api/v1), used live by Vacancy Analyzer /
# Company Research / Resume Selector / Writer / Critic / Evidence Checker / the Resume
# Library's text-cleanup pass. Leave OPENROUTER_API_KEY empty to fall back to Azure (below)
# or each agent's deterministic stub.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Required base model — every consumer below falls back to this one if it has no more
# specific override configured. Note the leading "~" — that's OpenRouter's real catalog id
# for this auto-router alias, not a typo; verify against openrouter.ai/api/v1/models if
# models ever get renamed, since these ids do change over time.
LLM_MODEL_DEFAULT=~anthropic/claude-haiku-latest

# Optional: point any consumer at its own independent model. All are optional; an unset
# one just falls back to LLM_MODEL_DEFAULT.
LLM_MODEL_WRITER=anthropic/claude-sonnet-5
LLM_MODEL_CRITIC=openai/gpt-5.5
LLM_MODEL_VACANCY_ANALYZER=
# Also drives the salary-range estimate when no search data was found at any
# ladder tier — point this at a stronger model if that "model estimate"
# fallback quality matters to you.
LLM_MODEL_COMPANY_RESEARCH=
LLM_MODEL_RESUME_SELECTOR=
LLM_MODEL_EVIDENCE_CHECKER=
LLM_MODEL_RESUME_LIBRARY=

# Azure OpenAI connection — kept as an alternative provider, not required if OpenRouter
# above is configured. Leave AZURE_OPENAI_API_KEY empty to fall back to OpenRouter or each
# agent's deterministic stub — no network, no cost, used by tests.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# Required base deployment — every consumer below falls back to this one if it has no
# more specific override configured.
AZURE_OPENAI_DEPLOYMENT=

# Optional: point any consumer at its own independent deployment/model. All are optional;
# an unset one just falls back to AZURE_OPENAI_DEPLOYMENT (Critic falls back to
# AZURE_OPENAI_DEPLOYMENT_LARGE first, for backwards compatibility, then the base one).
AZURE_OPENAI_DEPLOYMENT_LARGE=
AZURE_OPENAI_DEPLOYMENT_VACANCY_ANALYZER=
AZURE_OPENAI_DEPLOYMENT_COMPANY_RESEARCH=
AZURE_OPENAI_DEPLOYMENT_RESUME_SELECTOR=
AZURE_OPENAI_DEPLOYMENT_WRITER=
AZURE_OPENAI_DEPLOYMENT_CRITIC=
AZURE_OPENAI_DEPLOYMENT_EVIDENCE_CHECKER=
AZURE_OPENAI_DEPLOYMENT_RESUME_LIBRARY=

# Writer length guidance (see src/agents/writerAgent.ts) — soft limits: enforced via the
# prompt and checked by the Critic and a post-generation warning, never a hard failure.
# Defaults shown are used when unset.
WRITER_COVER_LETTER_MIN_WORDS=200
WRITER_COVER_LETTER_MAX_WORDS=450
WRITER_ANSWER_MAX_WORDS=150

# Overrides the default ./data directory for SQLite + run artifacts.
DATA_DIR=

# Overrides the GUI's default port for local dev. Most PaaS platforms
# (Railway, Render, Heroku, ...) inject their own PORT instead — that one
# wins automatically if set, so you don't need to touch this for a cloud
# deploy.
GUI_PORT=

# The server only binds to loopback (127.0.0.1) by default — correct for a
# plain "npm start" on your own machine, but that also means it's completely
# unreachable on a PaaS deploy (Railway, Render, ...) unless you opt in here.
# Set this to 0.0.0.0 whenever something other than localhost needs to reach
# it: a cloud platform's own edge proxy, or your own nginx/Caddy in front.
GUI_HOST=

# --- Multi-workspace mode: Admin / Demo / Workbenches ---
# Leave ADMIN_PASSWORD unset for today's default: one shared instance at "/",
# no login, unaffected by anything below. Setting it switches the same
# process to path-prefixed routing instead: /admin (password-gated, same data
# as before), optionally /demo (public — see ENABLE_DEMO), and any number of
# /workbench/<slug> instances created from Admin -> Workbenches. See the
# README's "Multi-workspace mode" section before enabling this.
ADMIN_PASSWORD=

# Public demo workspace at /demo — requires ADMIN_PASSWORD above to also be
# set (its own independent flag on purpose). Always forced to stub-only LLM
# and stub-only search regardless of any real key configured elsewhere.
ENABLE_DEMO=false

# How long a demo run survives before the retention sweep deletes it (hours),
# and how many expensive actions (analyze/retry/generate/regenerate/add-
# question) one IP may trigger per hour.
DEMO_RUN_TTL_HOURS=48
DEMO_RATE_LIMIT_PER_HOUR=10

# Same expensive-action cap as demo's, but for admin/workbench (kept separate
# and higher by default — trusted users, but still a real cap against runaway
# cost from a careless or malicious workbench). Never applies in legacy/
# single-instance mode (no ADMIN_PASSWORD), regardless of this value.
WORKSPACE_RATE_LIMIT_PER_HOUR=30

# How many login attempts (admin or any workbench) one IP may make per hour.
LOGIN_RATE_LIMIT_PER_HOUR=20

# The header your reverse proxy sets with the real client IP (must overwrite,
# not append to, a client-supplied value) — used by all rate limiters above.
# Only matters once this is actually proxied; irrelevant for a plain
# SSH-tunneled admin-only setup. Defaults to "x-real-ip" (correct for a
# typical nginx front-end). A PaaS's own edge proxy usually sets
# "x-forwarded-for" instead (Railway does) — check yours, or per-IP rate
# limiting silently keys off the proxy's own address instead of the real
# visitor.
TRUSTED_CLIENT_IP_HEADER=

# Set to true once a fronting proxy terminates TLS for this process, so
# session cookies get the Secure flag. Leave false for a plain HTTP SSH
# tunnel. On a PaaS deploy (Railway, Render, ...) this should be true — the
# browser's connection to the platform's own domain is real HTTPS even
# though it reaches this process over plain HTTP internally.
COOKIE_SECURE=false
