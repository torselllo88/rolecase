{
  "name": "rolecase",
  "version": "0.1.0",
  "description": "An AI assistant for evaluating job opportunities and drafting tailored applications, with human approval at every step.",
  "license": "Apache-2.0",
  "keywords": ["ai-agents", "job-search", "resume", "cover-letter", "llm", "multi-agent", "openrouter"],
  "type": "module",
  "private": true,
  "bin": {
    "rolecase": "./dist/cli/index.js"
  },
  "scripts": {
    "setup": "npm install",
    "start": "npm run setup && npm run gui",
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "gui": "tsx src/gui/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
